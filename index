                    background: cfg.result.background || ""
                };
                setText("saveMsg", "Menyimpan...");
                const bgFiles = [["setWelcomeBackground", "welcome"], ["setHomeBackground", "home"], ["setCountBackground", "count"], ["setPlayBackground", "play"], ["setResultBackground", "result"]];
                for (const [id,key] of bgFiles) {
                    const v = await compressImage($(id), 1100, .72);
                    if (v)
                        cfg[key].background = v;
                }
                const image = await compressImage($("setImage"), 900, .78);
                if (image)
