        async function requestConfig(body=null) {
            let lastError = null;
            for (const endpoint of CONFIG_ENDPOINTS) {
                try {
                    const opts = body === null ? {
                        method: "GET",
                        cache: "no-store"
                    } : {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify(body)
                    };
                    const r = await fetch(endpoint + (body === null ? "?ts=" + Date.now() : ""), opts);
                    let data = {};
                    try {
                        data = await r.json()
                    } catch (e) {}
                    if (r.ok)
                        return data;
                    lastError = new Error(data.error || ("Server config error " + r.status));
                } catch (e) {
                    lastError = e;
                }
            }
            throw lastError || new Error("Failed to fetch");
        }
        async function syncCloudConfig(force=false) {
