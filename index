                }
                // Simpan lokal sebagai sumber utama. Sinkronisasi server hanya tambahan,
                // jadi setting tidak gagal hanya karena Netlify Function / server config bermasalah.
                apply();
                let cloudSaved = false;
                try {
                    const cloud = await cloudRequest({
                        action: "save",
