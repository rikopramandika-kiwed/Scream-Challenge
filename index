        <style>
            * {
                box-sizing: border-box
            }

            body {
                margin: 0;
                font-family: Arial,Helvetica,sans-serif;
                color: #fff;
                background: #050505;
                min-height: 100vh
            }

            button,input,textarea,select {
                font: inherit
            }

            button {
                cursor: pointer
            }

            .app {
                min-height: 100vh;
                background: radial-gradient(circle at 50% 35%,#342300 0,#0d0b05 32%,#030303 75%);
                overflow: hidden
            }

            header {
                height: 64px;
                padding: 0 24px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                border-bottom: 1px solid #6e5317;
                background: #050505cc
            }

            .brand {
                font-weight: 900;
                letter-spacing: 1px
            }

            .brand b {
                color: #ffc83d
            }

            .gear {
                border: 1px solid #8d6a20;
                background: #111;
                color: #ffd45a;
                border-radius: 9px;
                padding: 9px 12px
            }

            main {
                min-height: calc(100vh - 64px);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 24px
            }

            .screen {
                width: min(900px,100%);
                text-align: center
            }

            .logo {
                max-width: 210px;
                max-height: 90px;
                object-fit: contain;
                margin-bottom: 8px
            }

            .hidden {
                display: none!important
            }

            h1 {
                font-size: clamp(36px,7vw,76px);
                line-height: .95;
                margin: 10px 0;
                color: #ffd04a;
                text-shadow: 0 0 30px #b87d004d
            }

            .sub {
                font-size: 18px;
                color: #ddd;
                margin: 15px 0 25px
            }

            .name {
                width: min(440px,90%);
                padding: 17px 18px;
                border: 1px solid #8d6a20;
                background: #101010;
                color: #fff;
                border-radius: 12px;
                outline: none
            }

            .primary {
                display: block;
                margin: 18px auto;
                padding: 16px 48px;
                border: 0;
                border-radius: 13px;
                background: linear-gradient(#ffe08a,#e9a91f);
                color: #111;
                font-size: 21px;
                font-weight: 900;
                box-shadow: 0 8px 30px #d5961e44
            }

            .secondary {
                padding: 12px 20px;
                border: 1px solid #9d7625;
                background: #111;
                color: #fff;
                border-radius: 10px
            }

            .count {
                font-size: clamp(100px,22vw,220px);
                font-weight: 900;
                color: #ffd04a;
                text-shadow: 0 0 45px #e6a40066
            }

            .participant {
                font-size: 22px;
                margin-bottom: 10px
            }

            .phone {
                width: min(78%,760px);
                height: auto;
                aspect-ratio: var(--lcd-ratio,1/1.76);
                margin: 12px auto 18px;
                position: relative;
                display: flex;
                align-items: center;
                justify-content: center;
                background: transparent;
                border: 0;
                padding: 0;
                box-shadow: none;
                flex: 0 0 auto
            }

            .phone:before {
                display: none
            }

            .lcd {
                width: 100%;
                height: 100%;
                position: relative;
                display: flex;
                align-items: center;
                justify-content: center;
                background: transparent;
                overflow: visible
            }

            .lcd img {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: contain;
                display: block;
                user-select: none;
                -webkit-user-drag: none
            }

            .lcd .lcd-base {
                filter: grayscale(1) contrast(1.05);
                z-index: 1
            }

            .lcd .lcd-color {
                filter: none;
                z-index: 2;
                clip-path: polygon(0 var(--wave-y,100%),10% calc(var(--wave-y,100%) - 2%),20% calc(var(--wave-y,100%) + 1.5%),30% calc(var(--wave-y,100%) - 1%),40% calc(var(--wave-y,100%) + 2%),50% calc(var(--wave-y,100%) - 1.5%),60% calc(var(--wave-y,100%) + 1%),70% calc(var(--wave-y,100%) - 2%),80% calc(var(--wave-y,100%) + 1.5%),90% calc(var(--wave-y,100%) - 1%),100% var(--wave-y,100%),100% 100%,0 100%);
                transition: clip-path .06s linear;
                will-change: clip-path
            }

            .lcd .fill {
                position: absolute;
                left: 0;
                bottom: 0;
                width: 100%;
                height: 0;
                background: linear-gradient(180deg,#ffffff22,var(--fill-color,#ffd04a)88);
                mix-blend-mode: screen;
                opacity: .22;
                z-index: 3;
                pointer-events: none;
                transition: height .04s
            }

            .lcd .fillline {
                position: absolute;
                left: 0;
                bottom: 0;
                width: 100%;
                height: 3px;
                background: var(--fill-color,#ffe06a);
                box-shadow: 0 0 20px var(--fill-color,#ffd34d);
                z-index: 4;
                opacity: .9
            }

            .lcd .pct {
                position: absolute;
                inset: auto 0 14px;
                text-align: center;
                font-size: 25px;
                font-weight: 900;
                text-shadow: 0 2px 7px #000;
                z-index: 5;
                display: none
            }

            .meter {
                width: min(650px,90%);
                height: 25px;
                background: #1a1a1a;
                border: 1px solid #7d6020;
                border-radius: 30px;
                margin: 12px auto;
                overflow: hidden
            }

            .meter>div {
                height: 100%;
                width: 0;
                background: linear-gradient(90deg,#8bdc18,#ffe04c);
                transition: width .04s
            }

            .timer {
                font-size: 30px;
                font-weight: 900;
                color: #ffd04a
            }

            .scorelive {
                font-size: 20px;
                color: #ddd
            }

            .result h2 {
                font-size: 28px
            }

            .final {
                font-size: 120px;
                line-height: 1;
                font-weight: 900;
                color: #ffd04a
            }

            .outof {
                font-size: 22px;
                color: #bbb
            }

            .success {
                font-size: 25px;
                color: #ffd04a;
                font-weight: 900;
                margin: 15px
            }

            .admin {
                width: min(850px,100%);
                background: #0c0c0c;
                border: 1px solid #624b18;
                border-radius: 18px;
                padding: 25px;
                text-align: left;
                box-shadow: 0 20px 70px #000
            }

            .admin h2 {
                margin-top: 0;
                color: #ffd04a
            }

            .row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 14px
            }

            .field {
                margin: 12px 0
            }

            .field label {
                display: block;
                font-weight: 700;
                margin-bottom: 7px;
                color: #ddd
            }

            .field input,.field textarea,.field select {
                width: 100%;
                padding: 12px;
                border-radius: 9px;
                border: 1px solid #5f4b20;
                background: #151515;
                color: #fff
            }

            .field textarea {
                min-height: 75px
            }

            .actions {
                display: flex;
                gap: 10px;
                flex-wrap: wrap;
                margin-top: 20px
            }

            .note {
                color: #999;
                font-size: 13px
            }

            .status {
                min-height: 20px;
                color: #ffd04a;
                margin-top: 8px
            }

            @media(max-width: 650px) {
                .row {
                    grid-template-columns:1fr
                }

                .phone {
                    width: 78%;
                    height: auto
                }

                header {
                    padding: 0 12px
                }
            }

            .screen-settings {
                margin: 0 auto 22px;
                max-width: 850px;
                padding: 16px;
                border: 1px solid #624b18;
                border-radius: 14px;
                background: #101010
            }

            .screen-settings h3 {
                margin: 0 0 12px;
                color: #ffd04a
            }

            .color-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px
            }

            .preview {
                padding: 10px;
                border: 1px dashed #5f4b20;
                border-radius: 9px;
                color: #aaa;
                font-size: 13px
            }

            @media(max-width: 650px) {
                .color-grid {
                    grid-template-columns:1fr
                }
            }

            /* v8: logo pop-up on every screen */
            @keyframes logoPopIn {
                0% {
                    opacity: 0;
                    transform: translateY(18px) scale(.55)
                }

                60% {
                    opacity: 1;
                    transform: translateY(-4px) scale(1.08)
                }

                100% {
                    opacity: 1;
                    transform: translateY(0) scale(1)
                }
            }

            .screen:not(.hidden) .logo:not(.hidden) {
                animation: logoPopIn .65s cubic-bezier(.2,.85,.25,1.2) both;
                transform-origin: center top
            }

            /* v9: grayscale play background + water-wave color reveal */
            .play-bg {
                position: absolute;
                inset: 0;
                background-position: center;
                background-size: cover;
                background-repeat: no-repeat;
                pointer-events: none;
                z-index: 0
            }

            .play-bg-gray {
                filter: grayscale(1) contrast(1.04);
                background-color: #111
            }

            .play-bg-color {
                filter: none;
                clip-path: polygon(0 var(--bg-wave-y,100%),10% calc(var(--bg-wave-y,100%) - 3%),20% calc(var(--bg-wave-y,100%) + 2%),30% calc(var(--bg-wave-y,100%) - 2%),40% calc(var(--bg-wave-y,100%) + 3%),50% calc(var(--bg-wave-y,100%) - 2%),60% calc(var(--bg-wave-y,100%) + 2%),70% calc(var(--bg-wave-y,100%) - 3%),80% calc(var(--bg-wave-y,100%) + 2%),90% calc(var(--bg-wave-y,100%) - 2%),100% var(--bg-wave-y,100%),100% 100%,0 100%);
                transition: clip-path .06s linear;
                will-change: clip-path
            }

            #play>*:not(.play-bg) {
                position: relative;
                z-index: 2
            }

            /* Logo pop-up normal: hanya muncul sekali saat layar dibuka, tanpa efek melayang */
            @keyframes logoContinuousPulse {
                0% {
                    transform: scale(1)
                }

                12% {
                    transform: scale(1.028)
                }

                25% {
                    transform: scale(1)
                }

                37% {
                    transform: scale(1.022)
                }

                50% {
                    transform: scale(1)
                }

                62% {
                    transform: scale(1.028)
                }

                75% {
                    transform: scale(1)
                }

                87% {
                    transform: scale(1.022)
                }

                100% {
                    transform: scale(1)
                }
            }

            #welcome .logo,#home .logo,#countdown .logo,#play .logo,#result .logo {
                animation: logoContinuousPulse 2.8s ease-in-out infinite!important;
                transform-origin: center center
            }

            /* v11: ukuran logo dikontrol dari Admin */
            #welcome .logo,#home .logo,#countdown .logo,#play .logo,#result .logo {
                width: var(--logo-size,25%);
                max-width: none!important;
                max-height: 20vh;
                height: auto
            }

            /* SCREEN TEXT: Roboto Bold — warna dikontrol oleh Admin */
            @import url("https://fonts.googleapis.com/css2?family=Roboto:wght@700;900&display=swap"); #home,#countdown,#play,#result,#welcome {
                font-family: "Roboto",Arial,sans-serif !important;
                font-weight: 700;
            }

            #home h1,#home .sub,#home .note,#countdown .sub,#countdown .count,#play .play-percent,#play .timer,#play .scorelive,#play .participant,#play #who,#result h2,#result .result-percent,#result .result-sub,#result .result-status,#result .leaderboard-title,#result .leader-row,#result .leader-row span,#welcome .tap {
                font-family: "Roboto",Arial,sans-serif !important;
                font-weight: 700 !important;
            }

            #countdown #countNum {
                font-family: "Roboto",Arial,sans-serif !important;
                font-weight: 900 !important;
            }
        </style>
