        function finish() {
            if (gameFinished)
                return;
            gameFinished = true;
            gameLoopActive = false;
            try {
                cancelAnimationFrame(raf);
            } catch (e) {}
            raf = null;
            try {
                if (stream)
                    stream.getTracks().forEach(t => {
                        try {
                            t.stop()
                        } catch (e) {}
                    }
                    );
            } catch (e) {}
