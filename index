        async function boot() {
            try {
                const sens = $("setSensitivity");
                if (sens)
                    sens.addEventListener("input", () => $("sensVal").textContent = "× " + (+sens.value).toFixed(1));
                apply();
                await syncCloudConfig(true);
                if (cloudSyncTimer)
                    clearInterval(cloudSyncTimer);
                cloudSyncTimer = setInterval( () => syncCloudConfig(false), 5000);
            } catch (err) {
                console.error("BOOT ERROR", err);
            }
            show("welcome");
            const welcome = $("welcome");
            if (welcome) {
                welcome.style.pointerEvents = "auto";
                welcome.onclick = enterHome;
            }
            document.addEventListener("visibilitychange", () => {
                if (document.hidden && gameLoopActive) {
                    /* Jangan biarkan RAF menumpuk ketika tab/background ditinggal. */
                    try {
                        cancelAnimationFrame(raf)
                    } catch (e) {}
                    raf = null;
                    if (analyser)
                        lastLoopTime = performance.now();
                } else if (!document.hidden && gameLoopActive && !gameFinished) {
                    lastLoopTime = performance.now();
                    raf = requestAnimationFrame(loop);
                }
            }
            );
            window.addEventListener("pagehide", stopMedia, {
                passive: true
            });
        }
        if (document.readyState === "loading")
            document.addEventListener("DOMContentLoaded", boot);
        else
            boot();
        document.addEventListener("keydown", e => {
