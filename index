        async function startMic() {
            if (gameLoopActive)
                return;
            try {
                const secure = window.isSecureContext || location.hostname === "localhost" || location.hostname === "127.0.0.1";
                if (!secure) {
                    throw new Error("MIC_HTTPS_REQUIRED");
                }
                if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                    throw new Error("Browser/perangkat tidak menyediakan akses mikrofon.");
                }

                stopMedia();

                stream = await navigator.mediaDevices.getUserMedia({
                    audio: {
                        echoCancellation: true,
                        noiseSuppression: true,
                        autoGainControl: true,
                        channelCount: 1
                    },
                    video: false
                });

                const AC = window.AudioContext || window.webkitAudioContext;
                if (!AC)
                    throw new Error("Web Audio API tidak tersedia.");
                audioCtx = new AC({
                    latencyHint: "interactive"
                });
                if (audioCtx.state === "suspended")
                    await audioCtx.resume();

                const src = audioCtx.createMediaStreamSource(stream);
                analyser = audioCtx.createAnalyser();
                analyser.fftSize = 512;
                analyser.smoothingTimeConstant = .65;
                src.connect(analyser);
                data = new Uint8Array(analyser.fftSize);

                fillLevel = 0;
                lastLoopTime = performance.now();
                lastUiUpdate = 0;
                lastUiFill = -1;
                gameLoopActive = true;

                show("play");
                setText("who", name);
                if ($("lcdImg"))
                    $("lcdImg").src = cfg.image;
                if ($("lcdImgGray"))
                    $("lcdImgGray").src = cfg.image;
                fitLcdCostume();
                if ($("lcdStage")) {
                    $("lcdStage").style.setProperty("--fill-level", "0%");
                    $("lcdStage").style.setProperty("--wave-y", "100%");
                    $("lcdStage").style.setProperty("--fill-color", (cfg.play && cfg.play.fillColor) || "#ffd04a");
                }
                t0 = performance.now();
                raf = requestAnimationFrame(loop);
            } catch (e) {
                console.error("MIC ERROR", e);
                gameLoopActive = false;
                stopMedia();
                if (e && e.message === "MIC_HTTPS_REQUIRED") {
                    alert("Aplikasi ini membutuhkan HTTPS untuk akses microphone.\n\nBuka lewat alamat https://... atau jalankan di localhost.");
                } else if (e && (e.name === "NotAllowedError" || e.name === "SecurityError")) {
                    alert("Izin microphone ditolak. Izinkan microphone untuk situs ini, lalu tekan START lagi.");
                } else {
                    alert("Mic tidak bisa dipakai: " + (e.message || "error tidak diketahui"));
                }
                show("home");
            }
        }

        let lastLoopTime = performance.now();
        function loop(now) {
            if (!gameLoopActive || gameFinished || !analyser || !data)
                return;

            const elapsed = (now - t0) / 1000;
            const remain = Math.max(0, cfg.duration - elapsed);
            if ($("timer"))
                $("timer").textContent = remain.toFixed(1);

            analyser.getByteTimeDomainData(data);
            let sum = 0;
            for (let i = 0; i < data.length; i++) {
                const v = (data[i] - 128) / 128;
                sum += v * v;
            }
            const rms = Math.sqrt(sum / data.length);
            const raw = Math.max(0, (rms * 100 * cfg.sensitivity * 1.8) - 8);
            const level = Math.min(100, Math.pow(raw / 100, 1.65) * 100);

            const dt = Math.min(.12, Math.max(.008, (now - lastLoopTime) / 1000));
            lastLoopTime = now;

            if (level > 3) {
                fillLevel = Math.min(100, fillLevel + (level / Math.max(1, cfg.target)) * .24);
            } else {
                fillLevel = Math.max(0, fillLevel - (2.0 * dt));
            }

            /* Update visual DOM at most ~30fps; microphone sampling stays smooth. */
            if (now - lastUiUpdate >= 33 || fillLevel >= 100 || elapsed >= cfg.duration) {
                lastUiUpdate = now;
                const rounded = Math.round(fillLevel);
                if (Math.abs(fillLevel - lastUiFill) >= .25 || fillLevel >= 100) {
                    lastUiFill = fillLevel;
                    const waveY = (100 - fillLevel) + "%";
                    const stage = $("lcdStage");
                    if (stage) {
                        stage.style.setProperty("--fill-level", fillLevel + "%");
                        stage.style.setProperty("--wave-y", waveY);
                    }
                    const bg = $("playBgColor");
                    if (bg)
                        bg.style.setProperty("--bg-wave-y", waveY);
                    const fill = $("fill");
                    if (fill)
                        fill.style.height = fillLevel + "%";
                    if ($("pct"))
                        $("pct").textContent = rounded + "%";
                    if ($("live"))
                        $("live").textContent = rounded + "%";
                    if ($("playPercent"))
                        $("playPercent").textContent = rounded + "%";
                }
                if ($("meterFill"))
                    $("meterFill").style.width = level + "%";
            }

            if (fillLevel >= 100) {
                fillLevel = 100;
                finish();
                return;
            }
            if (elapsed < cfg.duration) {
                raf = requestAnimationFrame(loop);
            } else {
                finish();
            }
        }

