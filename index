                }
                );
                return true;
            } catch (e) {
                console.error(e);
                setText("saveMsg", "Gagal menyimpan: " + (e.message || "periksa pengaturan"));
                return false;
            }
        }

        async function exportShareFile() {
            try {
                // Pastikan form + upload benar-benar sudah diproses sebelum file portable dibuat.
                const ok = await saveAdmin();
                if (!ok)
                    throw new Error("Pengaturan belum berhasil disimpan. Periksa pesan error di Admin.");
                const liveCfg = JSON.parse(JSON.stringify(cfg));
                const safeJson = JSON.stringify(liveCfg).replace(/</g, "\\u003c").replace(/>/g, "\\u003e").replace(/\u2028/g, "\\u2028").replace(/\u2029/g, "\\u2029");
                let html = "<!doctype html>" + document.documentElement.outerHTML;
                html = html.replace("const EMBEDDED_CONFIG = null;", "const EMBEDDED_CONFIG = " + safeJson + ";");
                const blob = new Blob([html],{
                    type: "text/html;charset=utf-8"
                });
                const url = URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = url;
                a.download = "ScreamChallenge_SHARE.html";
                document.body.appendChild(a);
                a.click();
                a.remove();
                setTimeout( () => URL.revokeObjectURL(url), 1000);
                setText("saveMsg", "File share berhasil dibuat. Kirim file ScreamChallenge_SHARE.html ini / upload ke hosting.");
            } catch (e) {
                console.error(e);
                setText("saveMsg", "Gagal membuat file share: " + (e.message || e));
            }
        }

