                    textColor: getVal("playTextColor", DEFAULT.play.textColor) || DEFAULT.play.textColor,
                    percentColor: getVal("playPercentColor", DEFAULT.play.percentColor) || DEFAULT.play.percentColor,
                    timerColor: getVal("playTimerColor", DEFAULT.play.timerColor) || DEFAULT.play.timerColor,
                    fillColor: getVal("playFillColor", DEFAULT.play.fillColor) || DEFAULT.play.fillColor,
                    background: cfg.play.background || ""
                };
                cfg.result = {
                    title: getVal("resultTitle", DEFAULT.result.title) || DEFAULT.result.title,
                    font: getVal("resultFont", DEFAULT.result.font) || DEFAULT.result.font,
                    messageLow: getVal("resultLowMessage", DEFAULT.result.messageLow) || DEFAULT.result.messageLow,
                    messageMid: getVal("resultMidMessage", DEFAULT.result.messageMid) || DEFAULT.result.messageMid,
                    messageFull: getVal("resultFullMessage", DEFAULT.result.messageFull) || DEFAULT.result.messageFull,
                    messageLowSize: Math.max(20, Math.min(140, +getVal("resultLowSize", DEFAULT.result.messageLowSize) || DEFAULT.result.messageLowSize)),
                    messageMidSize: Math.max(20, Math.min(140, +getVal("resultMidSize", DEFAULT.result.messageMidSize) || DEFAULT.result.messageMidSize)),
