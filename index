                    font: getVal("homeFont", DEFAULT.home.font) || DEFAULT.home.font,
                    subtitle: getVal("homeSubtitle", DEFAULT.home.subtitle) || DEFAULT.home.subtitle,
                    placeholder: getVal("homePlaceholder", DEFAULT.home.placeholder) || DEFAULT.home.placeholder,
                    buttonText: getVal("homeButtonText", DEFAULT.home.buttonText) || DEFAULT.home.buttonText,
                    textColor: getVal("homeTextColor", DEFAULT.home.textColor) || DEFAULT.home.textColor,
